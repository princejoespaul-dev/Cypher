{
  "components": {
    "schemas": {
      "FindingEventRecord": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "build_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "details": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Details",
            "type": "object"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "$ref": "#/components/schemas/FindingEventType"
          },
          "finding_id": {
            "format": "uuid",
            "title": "Finding Id",
            "type": "string"
          },
          "fix_verification_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fix Verification Id"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          },
          "related_run_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Related Run Ids",
            "type": "array"
          },
          "run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "sequence": {
            "minimum": 1.0,
            "title": "Sequence",
            "type": "integer"
          },
          "suite_run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suite Run Id"
          }
        },
        "required": [
          "event_id",
          "sequence",
          "project_id",
          "finding_id",
          "event_type",
          "created_at"
        ],
        "title": "FindingEventRecord",
        "type": "object"
      },
      "FindingEventType": {
        "enum": [
          "open",
          "fixed_verified",
          "reintroduced"
        ],
        "title": "FindingEventType",
        "type": "string"
      },
      "FindingPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FindingRecord"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "FindingPage",
        "type": "object"
      },
      "FindingRecord": {
        "additionalProperties": false,
        "properties": {
          "capsule_id": {
            "format": "uuid",
            "title": "Capsule Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "finding_id": {
            "format": "uuid",
            "title": "Finding Id",
            "type": "string"
          },
          "fingerprint": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Fingerprint",
            "type": "string"
          },
          "first_seen_build_id": {
            "format": "uuid",
            "title": "First Seen Build Id",
            "type": "string"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "project_id",
          "fingerprint",
          "capsule_id",
          "first_seen_build_id",
          "created_at"
        ],
        "title": "FindingRecord",
        "type": "object"
      },
      "FindingTimelineResponse": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/FindingEventRecord"
            },
            "title": "Events",
            "type": "array"
          },
          "finding_id": {
            "format": "uuid",
            "title": "Finding Id",
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "events"
        ],
        "title": "FindingTimelineResponse",
        "type": "object"
      },
      "FixOutcome": {
        "enum": [
          "FIX_VERIFIED",
          "FIX_INCOMPLETE",
          "FIX_BREAKS_CONTROL",
          "FIX_UNVERIFIABLE"
        ],
        "title": "FixOutcome",
        "type": "string"
      },
      "FixVerificationRecord": {
        "additionalProperties": false,
        "properties": {
          "capsule_version_id": {
            "format": "uuid",
            "title": "Capsule Version Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "fingerprint": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Fingerprint",
            "type": "string"
          },
          "fixed_build_id": {
            "format": "uuid",
            "title": "Fixed Build Id",
            "type": "string"
          },
          "fixed_run_id": {
            "format": "uuid",
            "title": "Fixed Run Id",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/FixOutcome"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          },
          "verification_id": {
            "format": "uuid",
            "title": "Verification Id",
            "type": "string"
          },
          "vulnerable_build_id": {
            "format": "uuid",
            "title": "Vulnerable Build Id",
            "type": "string"
          },
          "vulnerable_run_id": {
            "format": "uuid",
            "title": "Vulnerable Run Id",
            "type": "string"
          }
        },
        "required": [
          "verification_id",
          "project_id",
          "fingerprint",
          "capsule_version_id",
          "vulnerable_build_id",
          "fixed_build_id",
          "vulnerable_run_id",
          "fixed_run_id",
          "outcome",
          "created_by",
          "created_at"
        ],
        "title": "FixVerificationRecord",
        "type": "object"
      },
      "FixVerificationRequest": {
        "additionalProperties": false,
        "properties": {
          "fixed_run_id": {
            "format": "uuid",
            "title": "Fixed Run Id",
            "type": "string"
          },
          "vulnerable_run_id": {
            "format": "uuid",
            "title": "Vulnerable Run Id",
            "type": "string"
          }
        },
        "required": [
          "vulnerable_run_id",
          "fixed_run_id"
        ],
        "title": "FixVerificationRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobAccepted": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "state": {
            "default": "queued",
            "title": "State",
            "type": "string"
          },
          "status_url": {
            "title": "Status Url",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status_url"
        ],
        "title": "JobAccepted",
        "type": "object"
      },
      "JsonValue": {},
      "ReadjudicateRequest": {
        "additionalProperties": false,
        "properties": {
          "adjudicator_version": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
            "title": "Adjudicator Version",
            "type": "string"
          }
        },
        "required": [
          "adjudicator_version"
        ],
        "title": "ReadjudicateRequest",
        "type": "object"
      },
      "RegressionSuiteCreate": {
        "additionalProperties": false,
        "properties": {
          "capsule_version_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Capsule Version Ids",
            "type": "array"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "capsule_version_ids"
        ],
        "title": "RegressionSuiteCreate",
        "type": "object"
      },
      "RegressionSuiteRecord": {
        "additionalProperties": false,
        "properties": {
          "capsule_version_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Capsule Version Ids",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          },
          "suite_id": {
            "format": "uuid",
            "title": "Suite Id",
            "type": "string"
          }
        },
        "required": [
          "suite_id",
          "project_id",
          "name",
          "capsule_version_ids",
          "created_by",
          "created_at"
        ],
        "title": "RegressionSuiteRecord",
        "type": "object"
      },
      "RegressionSuiteRunRequest": {
        "additionalProperties": false,
        "properties": {
          "build_id": {
            "format": "uuid",
            "title": "Build Id",
            "type": "string"
          },
          "repeats": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Repeats",
            "type": "integer"
          }
        },
        "required": [
          "build_id"
        ],
        "title": "RegressionSuiteRunRequest",
        "type": "object"
      },
      "StoredVerdictRecord": {
        "additionalProperties": false,
        "properties": {
          "adjudicator_version": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Adjudicator Version",
            "type": "string"
          },
          "completeness_score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Completeness Score",
            "type": "number"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "fired_rules": {
            "items": {
              "type": "string"
            },
            "title": "Fired Rules",
            "type": "array"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "signals": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Signals",
            "type": "object"
          },
          "supersedes_verdict_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Verdict Id"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "verdict_id": {
            "format": "uuid",
            "title": "Verdict Id",
            "type": "string"
          }
        },
        "required": [
          "verdict_id",
          "project_id",
          "run_id",
          "verdict",
          "fired_rules",
          "signals",
          "completeness_score",
          "adjudicator_version",
          "created_at"
        ],
        "title": "StoredVerdictRecord",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Verdict": {
        "enum": [
          "VULNERABLE_STATE_CHANGE",
          "VULNERABLE_DATA_EXPOSURE",
          "PROTECTED",
          "INCONCLUSIVE_ENVIRONMENT",
          "INCONCLUSIVE_CONTROL",
          "INCONCLUSIVE_AMBIGUOUS",
          "INCONCLUSIVE_FLAKY"
        ],
        "title": "Verdict",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Findings, fix verification, regression recurrence, and append-only re-adjudication endpoints.",
    "title": "CYPHER Phase 5 API fragment",
    "version": "phase5-overlay-0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/findings": {
      "get": {
        "operationId": "list_findings_v1_findings_get",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Findings",
        "tags": [
          "phase-5-findings-fix-verification"
        ]
      }
    },
    "/v1/findings/{finding_id}/timeline": {
      "get": {
        "operationId": "finding_timeline_v1_findings__finding_id__timeline_get",
        "parameters": [
          {
            "in": "path",
            "name": "finding_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Finding Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingTimelineResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Finding Timeline",
        "tags": [
          "phase-5-findings-fix-verification"
        ]
      }
    },
    "/v1/fix-verifications": {
      "post": {
        "operationId": "verify_fix_v1_fix_verifications_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FixVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FixVerificationRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Fix",
        "tags": [
          "phase-5-findings-fix-verification"
        ]
      }
    },
    "/v1/regression-suites": {
      "post": {
        "operationId": "create_regression_suite_v1_regression_suites_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegressionSuiteCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegressionSuiteRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Regression Suite",
        "tags": [
          "phase-5-findings-fix-verification"
        ]
      }
    },
    "/v1/regression-suites/{suite_id}/run": {
      "post": {
        "operationId": "run_regression_suite_v1_regression_suites__suite_id__run_post",
        "parameters": [
          {
            "in": "path",
            "name": "suite_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Suite Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 8,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegressionSuiteRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Regression Suite",
        "tags": [
          "phase-5-findings-fix-verification"
        ]
      }
    },
    "/v1/verdicts/{verdict_id}/readjudicate": {
      "post": {
        "operationId": "readjudicate_verdict_v1_verdicts__verdict_id__readjudicate_post",
        "parameters": [
          {
            "in": "path",
            "name": "verdict_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Verdict Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadjudicateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredVerdictRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Readjudicate Verdict",
        "tags": [
          "phase-5-findings-fix-verification"
        ]
      }
    }
  }
}
