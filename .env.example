# Local development only. Never use these placeholder credentials outside a laptop.
CYPHER_ENV=development
CYPHER_API_KEY=dev-only-change-me
CYPHER_DATABASE_URL=postgresql+psycopg://cypher:cypher-local-only@localhost:5432/cypher
CYPHER_REDIS_URL=redis://localhost:6379/0
CYPHER_EVIDENCE_DIR=.cypher/evidence
CYPHER_SANDBOX_SUBNETS=172.28.0.0/16,172.30.0.0/24
CYPHER_REQUEST_TIMEOUT_SECONDS=8
CYPHER_MAX_REPEATS=5
CYPHER_MAX_BODY_BYTES=1048576
CYPHER_GUIDANCE_DAILY_TOKEN_CAP=100000
CYPHER_GUIDANCE_DAILY_COST_CAP_USD=5.0
CYPHER_GUIDANCE_ENABLED=false
